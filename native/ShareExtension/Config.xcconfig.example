// Copy to Config.xcconfig (gitignored) before building the app.
//
// The extension runs in its own process with no access to the app's login
// session, so it authenticates with the static bearer token instead. Both
// values are baked into the extension at build time via Info.plist.
//
// MIND THE URL. xcconfig treats "//" as the start of a comment, so a bare
// https://host is silently truncated to "https:". The "$()" below expands to
// nothing and exists solely to keep the two slashes from being adjacent.
// Keep that exact shape when you change the host.
MARCADOR_SERVER_URL = https:/$()/marcador.ricojam.es
MARCADOR_SHARE_TOKEN = paste-your-MARCADOR_TOKEN-here
