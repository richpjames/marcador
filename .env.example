# Web login password (required). Anything reachable on a public domain needs this.
MARCADOR_PASSWORD=change-me

# Bearer token the iOS/macOS Share Extension sends (required).
# Generate one with: openssl rand -hex 32
MARCADOR_TOKEN=change-me-too

# Signs the session cookie. Falls back to a hash of MARCADOR_PASSWORD when unset,
# which means changing the password logs every browser out.
MARCADOR_SECRET=

# Mistral, for the one-sentence descriptions. Without it links still save,
# they just arrive with no description.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

DATABASE_PATH=./data/marcador.db
PORT=3000
